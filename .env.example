# SubGuard configuration. Copy to .env:  cp .env.example .env
# Mock mode needs NO keys. Never commit .env.

# --- App ---------------------------------------------------------------------
APP_MODE=mock                       # mock (default, no keys) | sandbox (real PayPal sandbox + real LLM)
APP_HOST=127.0.0.1                  # local demo host
APP_PORT=8000                       # local demo port -> http://127.0.0.1:8000/
DATA_DIR=data                       # JSON data root; runtime files go in $DATA_DIR/runtime (gitignored)

# --- AI (sandbox mode only; mock mode uses fixtures) -------------------------
LLM_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=                  # required when LLM_PROVIDER=anthropic in sandbox mode
ANTHROPIC_MODEL=claude-opus-5-5     # a current Claude model id with vision + tool use (re-verified in milestone 4)
OPENAI_API_KEY=                     # required when LLM_PROVIDER=openai in sandbox mode
OPENAI_MODEL=gpt-5                  # a current OpenAI model id with vision + tool calling (re-verified in milestone 4)
LLM_TIMEOUT_SECONDS=30              # per LLM call

# --- PayPal (SANDBOX ONLY) ---------------------------------------------------
PAYPAL_CLIENT_ID=                   # developer.paypal.com -> Sandbox -> Apps & Credentials -> your REST app
PAYPAL_CLIENT_SECRET=               # same place; never commit it
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # must be the sandbox URL; anything else refuses to start
PAYPAL_ACCESS_TOKEN=                # for the PayPal MCP server: export PAYPAL_ACCESS_TOKEN=$(scripts/paypal_token.sh)
PAYPAL_ENVIRONMENT=SANDBOX          # must be SANDBOX
PAYPAL_TRANSPORT=mcp                # mcp | sdk : how get/cancel go in single-merchant mode
PAYPAL_MERCHANT_MODE=single         # single (one sandbox business owns all plans) | partner (experimental, PayPal-Auth-Assertion)
PAYPAL_SANDBOX_BUYER_EMAIL=         # sandbox personal account, for auto-approving demo subscriptions in `make seed`
PAYPAL_SANDBOX_BUYER_PASSWORD=      # its password (sandbox only)
PAYPAL_WEBHOOK_ID=                  # optional: webhook id for signature verification (needs a public URL, e.g. ngrok)
PAYPAL_AUTOPAY_URL=https://www.sandbox.paypal.com/myaccount/autopay/   # one-tap link for Layer 2 merchants

# --- Notifications -----------------------------------------------------------
ZAPIER_CATCH_HOOK_URL=              # optional: Zapier Catch Hook; empty -> notifications go to data/runtime/outbox/

# --- Hosting -----------------------------------------------------------------
RENDER_API_KEY=                     # optional: only for the Render MCP server / deploy automation
