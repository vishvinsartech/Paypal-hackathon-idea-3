# SubGuard configuration. Copy to .env:  cp .env.example .env
# Mock mode needs NO keys. Never commit .env.

# --- App ---------------------------------------------------------------------
APP_MODE=mock                       # mock (default, no keys) | sandbox (real PayPal sandbox + real LLM)
APP_HOST=127.0.0.1                  # local demo host
APP_PORT=8000                       # local demo port -> http://127.0.0.1:8000/
DATA_DIR=data                       # JSON data root; runtime files go in $DATA_DIR/runtime (gitignored)

# --- AI (sandbox mode only; mock mode uses fixtures) -------------------------
LLM_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=                  # required when LLM_PROVIDER=anthropic in sandbox mode
ANTHROPIC_MODEL=claude-opus-5-5     # current Claude model id with vision + tool use (verified 2026-11, D-028)
OPENAI_API_KEY=                     # required when LLM_PROVIDER=openai in sandbox mode
OPENAI_MODEL=gpt-5                  # an OpenAI model id with vision + tool calling + json_schema output (D-028)
LLM_TIMEOUT_SECONDS=30              # per LLM call

# --- PayPal (SANDBOX ONLY) ---------------------------------------------------
PAYPAL_CLIENT_ID=                   # developer.paypal.com -> Sandbox -> Apps & Credentials -> your REST app
PAYPAL_CLIENT_SECRET=               # same place; never commit it
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # must be the sandbox URL; anything else refuses to start
PAYPAL_ACCESS_TOKEN=                # for the PayPal MCP server: export PAYPAL_ACCESS_TOKEN=$(scripts/paypal_token.sh)
PAYPAL_ENVIRONMENT=SANDBOX          # must be SANDBOX
PAYPAL_TRANSPORT=mcp                # mcp | sdk : how get/cancel go in single-merchant mode
PAYPAL_MERCHANT_MODE=single         # single (one sandbox business owns all plans) | partner (experimental, PayPal-Auth-Assertion)
PAYPAL_SANDBOX_BUYER_EMAIL=         # sandbox personal account: auto-approves in `make seed` and the live demo's Start
PAYPAL_SANDBOX_BUYER_PASSWORD=      # its password (sandbox only)
DEMO_APPROVE_HEADED=true            # live demo Start (sandbox): show the browser window that approves as the buyer
PAYPAL_WEBHOOK_ID=                  # optional: webhook id for signature verification (needs a public URL, e.g. ngrok)
PAYPAL_AUTOPAY_URL=https://www.sandbox.paypal.com/myaccount/autopay/   # one-tap link for Layer 2 merchants

# --- Notifications -----------------------------------------------------------
ZAPIER_CATCH_HOOK_URL=              # optional: Zapier Catch Hook; empty -> notifications go to data/runtime/outbox/

# --- Demo --------------------------------------------------------------------
REPO_URL=https://github.com/vishvinsartech/Paypal-hackathon-idea-3   # footer GitHub + MIT license links
DEMO_SEED=true                      # on first start / reset (both modes), script userA's Penwright usage (opened twice)

# --- Demo prices and terms (fictional merchant) ------------------------------
# Defaults are the spec's numbers; the tests assert those (e.g. "Money protected" $524.88).
# These drive the merchant plan, the mock PayPal, `make seed` (sandbox plans) AND the shop page text,
# so the page and the PayPal plan always agree. Prices: positive, at most 2 decimals.
# After changing any of them: `make reset` (and `make seed` in sandbox mode). Existing subscriptions
# keep the consent snapshot of what the user agreed to.
DEMO_CURRENCY=USD                   # 3-letter ISO code used for every demo plan
PENWRIGHT_TRIAL_DAYS=10             # "free trial" length in days (first charge = trial days + 1)
PENWRIGHT_INTRO_PRICE=24.99         # monthly price after the trial
PENWRIGHT_INTRO_MONTHS=3            # paid months at the intro price
PENWRIGHT_STEP_UP_PRICE=49.99       # monthly price after the intro months
PENWRIGHT_NOTICE_DAYS=3             # written notice required before billing (real deadline = first charge - notice - 1)
PENWRIGHT_EXPORT_LIMIT=3            # trial ends early after more than this many exports

# --- Hosting -----------------------------------------------------------------
RENDER_API_KEY=                     # optional: only for the Render MCP server / deploy automation
